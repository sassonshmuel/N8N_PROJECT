    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet text = \"\";\nconst imageDescriptions = [];\nlet fileName = \"\";\n\nfor (const item of items) {\n  const data = item.json;\n\n  // Extract file name\n  if (data.file && data.file.file_name) {\n    fileName = data.file.file_name;\n  }\n\n  // Collect text\n  if (data.text) {\n    text += data.text + \"\\n\";\n  }\n\n  // Collect image descriptions\n  if (Array.isArray(data.data)) {\n\n    for (const aiResult of data.data) {\n\n      let output = aiResult.output || \"\";\n\n      // Remove markdown wrappers\n      output = output\n        .replace(/```json/g, \"\")\n        .replace(/```/g, \"\")\n        .trim();\n\n      try {\n        const parsed = JSON.parse(output);\n\n        imageDescriptions.push({\n          type: parsed.type,\n          summary: parsed.summary,\n          ocr_text: parsed.ocr_text\n        });\n\n      } catch (e) {\n        imageDescriptions.push({\n          raw_output: output\n        });\n      }\n    }\n  }\n}\n\nreturn [\n  {\n    json: {\n      file_name: fileName,\n      text: text.trim(),\n      images_descriptions: imageDescriptions\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2224,
        0
      ],
