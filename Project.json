      "parameters": {
        "jsCode": "const item = $input.first();\n\nconst originalName = item.json.file_name || \"document\";\nconst baseName = originalName.replace(/\\.[^.]+$/, \"\");\n\nconst md = `# ${originalName}\n\n## Summary\n${item.json.gemini_text?.summary || \"\"}\n\n## Classification\n${item.json.gemini_text?.classification || \"\"}\n\n## Sentiment\n${item.json.gemini_text?.sentiment || \"\"}\n\n## Department\n${item.json.department || \"\"}\n\n## Sensitivity\n${item.json.sensitivity || \"\"}\n\n## Routing Tag\n${item.json.routing_tag || \"\"}\n\n## Action Items\n${Array.isArray(item.json.gemini_text?.action_items)\n  ? item.json.gemini_text.action_items.map(a => `- ${a}`).join(\"\\n\")\n  : item.json.gemini_text?.action_items || \"\"}\n\n## Full JSON\n\n\\`\\`\\`json\n${JSON.stringify(item.json, null, 2)}\n\\`\\`\\`\n`;\n\nreturn [\n  {\n    json: {\n      filename: `${baseName}.md`\n    },\n    binary: {\n      fileContent: await this.helpers.prepareBinaryData(\n        Buffer.from(md, \"utf8\"),\n        `${baseName}.md`,\n        \"text/markdown\"\n      )\n    }\n  }\n];"
